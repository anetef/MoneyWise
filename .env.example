# Copie este arquivo para ".env" e preencha com os dados do projeto Firebase.
# Onde encontrar: Console do Firebase > Configurações do projeto > Seus apps >
# App da Web (</>) > Configuração do SDK.
#
# O prefixo EXPO_PUBLIC_ é obrigatório para o Expo enxergar as variáveis.
# Essas chaves identificam o projeto e podem ficar no app. Quem protege
# os dados são as Security Rules do Firestore (RNF-05).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
