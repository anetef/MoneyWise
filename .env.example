# Modelo de variáveis de ambiente do MoneyWise.
# Copie para .env (cp .env.example .env) e preencha com seus valores locais.
# O .env NUNCA deve ir para o Git.

# Nome do banco criado no PostgreSQL
DB_NAME=moneywise
# Usuário do banco (também usado pelo backend)
DB_USERNAME=moneywise
# Senha do banco: troque por uma senha sua
DB_PASSWORD=troque_esta_senha
# Porta exposta no seu computador
DB_PORT=5432
# Porta da API exposta no computador
API_PORT=8080
# Segredo usado para assinar os tokens JWT.
# Use um texto aleatório e longo (no mínimo 32 caracteres). Para gerar um: openssl rand -base64 48
JWT_SECRET=troque_por_um_segredo_aleatorio_com_pelo_menos_32_caracteres

# Duração do access token (opcional; padrão 15m)
JWT_ACCESS_TOKEN_TTL=15m
# Duração do refresh token (opcional; padrão 30d)
JWT_REFRESH_TOKEN_TTL=30d