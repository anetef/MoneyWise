# Modelo de variáveis de ambiente do MoneyWise.
# Copie para .env (cp .env.example .env) e preencha com seus valores locais.
# O .env NUNCA deve ir para o Git.

# Nome do banco criado no PostgreSQL
DB_NAME=moneywise
# Usuário do banco (também usado pelo backend)
DB_USERNAME=moneywise
# Senha do banco: troque por uma senha sua
DB_PASSWORD=troque_esta_senha
# Porta exposta no seu computador
DB_PORT=5432