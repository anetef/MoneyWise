rules_version = '2';

// Regras de segurança do Firestore (RNF-04, RNF-05, RN-02, RN-04, RN-08).
// Nenhuma consulta retorna dados de outro usuário, mesmo com um token válido.
// Publicar: `firebase deploy --only firestore:rules`
// (ou cole no Console > Firestore > Regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(goal) {
      return signedIn() && request.auth.uid in goal.data.memberIds;
    }

    function isAdmin(goal) {
      return signedIn() && request.auth.uid == goal.data.adminId;
    }

    // ---------------- Usuários ----------------
    // Perfil público mínimo (nome e e-mail) para permitir convites por e-mail.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ---------------- Transações pessoais ----------------
    // RN-08 / RF-15: o saldo pessoal nunca é visível para outras pessoas.
    match /transactions/{txId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['income', 'expense'];
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // ---------------- Caixinhas (metas) ----------------
    match /goals/{goalId} {
      // RN-02: só membros enxergam a caixinha.
      allow read: if isMember(resource);

      allow create: if signedIn()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Admin pode alterar tudo (meta, membros...). RN-04
      // Membro comum só pode mexer no saldo e na própria contribuição (via aporte).
      allow update: if isAdmin(resource)
        // Membro saindo da caixinha: só pode remover a si mesmo.
        || (isMember(resource)
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']))
        || (isMember(resource)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedAmount', 'members'])
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.adminId == resource.data.adminId);

      allow delete: if isAdmin(resource);

      // Histórico de aportes/retiradas da caixinha.
      match /entries/{entryId} {
        allow read: if isMember(get(/databases/$(database)/documents/goals/$(goalId)));
        allow create: if isMember(get(/databases/$(database)/documents/goals/$(goalId)))
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow update, delete: if false; // histórico imutável
      }
    }
  }
}
